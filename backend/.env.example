SECRET_KEY=replace-with-at-least-50-random-characters
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
DEMO_USER_PASSWORD=

# Private enterprise deployment. The server selects one canonical organization;
# clients do not send X-Organization-ID and cannot create additional tenants.
SINGLE_TENANT_MODE=True
SINGLE_TENANT_ORGANIZATION_ID=
SINGLE_TENANT_ORGANIZATION_SLUG=enterprise
SINGLE_TENANT_ORGANIZATION_NAME=Enterprise Workspace
SINGLE_TENANT_DEFAULT_ROLE=viewer

# Offline desktop license login. Only distribute the public key; never place
# the private signing key in this repository, environment, or desktop package.
LICENSE_AUTH_ENABLED=False
LICENSE_PRODUCT_ID=agent-studio
LICENSE_PUBLIC_KEY=
LICENSE_FILE_PATH=

# Database profile: postgresql for Cluster, sqlite for Local.
DATABASE_ENGINE=postgresql
DB_NAME=agent_studio
DB_USER=agent_studio
DB_PASSWORD=replace-me
DB_HOST=postgres
DB_PORT=5432

# SQLite Local profile (used only when DATABASE_ENGINE=sqlite)
SQLITE_PATH=./db.sqlite3
SQLITE_BUSY_TIMEOUT_SECONDS=5
SQLITE_BUSY_TIMEOUT_MS=5000
LOCAL_FILE_MANAGER_ENABLED=True
SQLITE_SYNCHRONOUS=FULL
# JSON object grouped by worker pool, for example:
# Registry replacement is atomic: when overriding it, declare every enabled pool.
EXECUTION_CHILD_ADAPTERS={"agent":{"agent-completion":"apps.agents.execution:execute_agent_completion"},"media":{"batch-transcribe":"modules.execution.runtime.builtin:execute_batch_transcribe"},"workflow":{"workflow-dag":"modules.execution.runtime.builtin:execute_workflow"},"evaluation":{"evaluation-suite":"apps.enterprise.execution:execute_evaluation"}}
EXECUTION_CHECKPOINT_MAX_BYTES=1048576
EXECUTION_WORKER_MAX_CHILDREN=2
EXECUTION_WORKFLOW_MAX_PARALLELISM=4
# Pool served by the default execution-worker container. Scale one service per
# pool when agent/media/workflow/evaluation use different adapter registries.
EXECUTION_WORKER_POOL=media
# Terminal Run event retention and bounded compaction.
RUN_EVENT_RETENTION_DAYS=30
RUN_EVENT_COMPACTION_BATCH_SIZE=500
# Local Artifact backend. Cloud deployments can supply a server-side signed
# URL factory as a dotted callable path.
ARTIFACT_STORAGE_BACKEND=local
ARTIFACT_ROOT=./artifacts
ARTIFACT_S3_BUCKET=
ARTIFACT_S3_PREFIX=agent-studio
ARTIFACT_S3_ENDPOINT_URL=
ARTIFACT_S3_REGION=
ARTIFACT_S3_ACCESS_KEY=
ARTIFACT_S3_SECRET_KEY=
ARTIFACT_ACCESS_TTL_SECONDS=300
ARTIFACT_ACCESS_URL_FACTORY=
EXECUTION_ARTIFACT_MAX_BYTES=104857600

# Optional OpenTelemetry export. Keep disabled unless an OTLP collector is configured.
OTEL_ENABLED=False
OTEL_SERVICE_NAME=agent-studio-backend
OTEL_DEPLOYMENT_ENVIRONMENT=production
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_INSECURE=False
REDIS_ENABLED=True
REDIS_HOST=redis
REDIS_PORT=6379

# The directory containing the graphflow_agent_engine Python package.
# GRAPHFLOW_SDK_PATH=D:/workspace/agent-engine/sdk/python
# GRAPHFLOW_WORKFLOW_PATH=D:/workspace/agent-engine/examples/agent_workflow.json
GRAPHFLOW_PROVIDER=openai
GRAPHFLOW_API_KEY=
GRAPHFLOW_BASE_URL=https://api.example.com/v1
GRAPHFLOW_MODEL=your-model
GRAPHFLOW_ENABLE_STREAMING=True
GRAPHFLOW_ENABLE_PERMISSIONS=True
GRAPHFLOW_ENABLE_SKILLS=True
GRAPHFLOW_SKILLS_DIRECTORY=C:/Users/dele/.graphflow/skills
AGENT_ENGINE_ADAPTER=codex

# Codex adapter (set AGENT_ENGINE_ADAPTER=codex globally, or configure an
# individual agent with model_config={"adapter":"codex"}).
# Default: launch the installed Codex CLI's app-server directly (no source SDK required).
CODEX_TRANSPORT=app-server
# Only used when CODEX_TRANSPORT=python-sdk or when resolving source-built binaries.
CODEX_REPOSITORY_PATH=D:/workspace/codex
CODEX_SDK_PATH=D:/workspace/codex/sdk/python/src
# CODEX_BINARY=D:/workspace/codex/codex-rs/target/release/codex.exe
CODEX_MODEL=
CODEX_SANDBOX=workspace-write
CODEX_APPROVAL_MODE=deny_all
CODEX_REQUEST_TIMEOUT_SECONDS=30
CODEX_SKILLS_DIRECTORY=C:/Users/dele/.codex/skills
AGENT_WORKSPACE_ROOT=/data/agent-workspaces
MEDIA_ROOT=/data/media

# Trusted bundled application package directory. Defaults to backend/app_center.
# APP_CENTER_ROOT=/app/app_center
APPLICATION_RUNTIME_ALLOWED_ROOTS=
CREATION_MASTER_ALLOW_ALL_PATHS=True

ANON_RATE_LIMIT=30/minute
USER_RATE_LIMIT=300/minute
SENTRY_DSN=

# Browser refresh credentials are HttpOnly. Keep Secure enabled outside local
# HTTP development; the default path limits the cookie to versioned APIs.
JWT_REFRESH_COOKIE_NAME=agent_studio_refresh
JWT_REFRESH_COOKIE_PATH=/api/v1/
JWT_REFRESH_COOKIE_SECURE=True
JWT_REFRESH_COOKIE_SAMESITE=Strict

# OIDC IdentityProvider client secrets should reference environment variables.
# The provider record's secret_ref points to a SecretReference name, whose
# `reference` field points to an environment variable such as:
# CORPORATE_OIDC_CLIENT_SECRET=replace-me

# SecretReference records point to environment names such as this one.
# ORG_ACME_LLM_API_KEY=replace-me
