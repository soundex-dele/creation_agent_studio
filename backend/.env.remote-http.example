# Standalone HTTP relay, one ASGI process, no Redis. Copy to backend/.env
# only for a new installation; merge settings into existing installations.
# Generate a persistent key: .venv/bin/python -c 'import secrets; print(secrets.token_urlsafe(48))'
SECRET_KEY=
DEBUG=False
# Add the actual server IP or hostname (without scheme or port).
ALLOWED_HOSTS=localhost,127.0.0.1
REGISTRATION_ENABLED=False
LICENSE_AUTH_ENABLED=False
DJANGO_ADMIN_ENABLED=True

DATABASE_ENGINE=sqlite
SQLITE_PATH=./db.sqlite3
REDIS_ENABLED=False
REMOTE_RELAY_ENABLED=True
REMOTE_RELAY_REDIS_URL=
REMOTE_RELAY_ALLOW_MEMORY=True
REMOTE_ACCESS_HOST_ENABLED=False
LOCAL_FILE_MANAGER_ENABLED=False

SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
JWT_REFRESH_COOKIE_SECURE=False
# One Caddy proxy in front of the backend.
REST_FRAMEWORK_NUM_PROXIES=1
OTEL_ENABLED=False
SENTRY_DSN=
