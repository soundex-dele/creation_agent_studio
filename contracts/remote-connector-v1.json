{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-studio:remote-connector:v1",
  "title": "Remote connector frame v1",
  "description": "HTTP contract: docs/REMOTE_ACCESS_API.md. Payloads are transient. cancel ends only a subscription; cancel Run requires a whitelisted command request.",
  "type": "object",
  "required": ["v", "type"],
  "properties": {
    "v": {"const": 1},
    "type": {"enum": ["ready", "hello", "request", "start", "chunk", "ack", "end", "error", "cancel", "ping", "pong", "revoked"]},
    "id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 100},
    "method": {"enum": ["GET", "POST"]},
    "path": {"type": "string", "pattern": "^/api/v1/", "maxLength": 2048},
    "body": {"type": ["string", "object", "null"]},
    "idempotency_key": {"type": "string", "maxLength": 160},
    "status": {"type": "integer", "minimum": 200, "maximum": 599},
    "content_type": {"type": "string"},
    "detail": {"type": "string", "maxLength": 500}
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties": {"type": {"enum": ["request", "start", "chunk", "ack", "end", "error", "cancel"]}}},
      "then": {"required": ["id"]}
    },
    {
      "if": {"properties": {"type": {"const": "request"}}},
      "then": {"required": ["method", "path", "body", "idempotency_key"], "properties": {"body": {"type": ["object", "null"]}}}
    },
    {
      "if": {"properties": {"type": {"const": "start"}}},
      "then": {"required": ["status", "content_type"]}
    },
    {
      "if": {"properties": {"type": {"const": "chunk"}}},
      "then": {"required": ["body"], "properties": {"body": {"type": "string", "contentEncoding": "base64", "maxLength": 43692}}}
    },
    {"if": {"properties": {"type": {"const": "hello"}}}, "then": {"required": ["name"]}},
    {"if": {"properties": {"type": {"const": "error"}}}, "then": {"required": ["detail"]}}
  ]
}
