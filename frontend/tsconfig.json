{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Path Aliases */
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@creation-master/*": ["../backend/app_center/creation_master/react/src/*"],
      "@creation-toolbox/*": ["../backend/app_center/creation_toolbox/react/src/*"],
      "@phosphor-icons/react": ["node_modules/@phosphor-icons/react"],
      "lucide-react": ["node_modules/lucide-react/dist/lucide-react.d.ts"],
      "react": ["node_modules/@types/react/index.d.ts"],
      "react/*": ["node_modules/@types/react/*"],
      "react-dom/*": ["node_modules/@types/react-dom/*"]
    },

    /* Linting */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "../backend/app_center/creation_master/react/src", "../backend/app_center/creation_toolbox/react/src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
