{
  "name": "agent-studio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:api-schema": "python ../backend/manage.py generate_swagger ../contracts/swagger.json --overwrite --format json && swagger2openapi ../contracts/swagger.json -o ../contracts/openapi.json",
    "generate:api-types": "openapi-typescript ../contracts/openapi.json -o src/api/generated.ts",
    "generate:api": "npm run generate:api-schema && npm run generate:api-types"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@aws-sdk/client-s3": "^3.1132.0",
    "@babel/runtime": "^7.29.7",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.7.2",
    "@uiw/codemirror-theme-github": "^4.25.11",
    "antd": "^5.29.3",
    "axios": "^1.18.0",
    "codemirror": "^6.0.2",
    "crypto-js": "^4.2.0",
    "highlight.js": "^11.12.0",
    "idb": "^8.0.3",
    "katex": "^0.16.47",
    "lucide-react": "^0.555.0",
    "markdown-it": "^14.3.2",
    "markdown-it-attrs": "^5.0.0",
    "markdown-it-container": "^4.0.0",
    "markdown-it-deflist": "^2.1.0",
    "markdown-it-emoji": "^3.1.0",
    "markdown-it-implicit-figures": "^0.9.0",
    "markdown-it-imsize": "^2.0.1",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-ruby": "^0.1.1",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdown-it-table-of-contents": "^0.4.4",
    "markdown-it-task-lists": "^2.1.1",
    "mathjax": "^3.2.2",
    "mermaid": "^11.17.2",
    "qiniu-js": "^3.4.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.6.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "sass": "^1.100.0",
    "swagger2openapi": "^7.0.8",
    "tiny-oss": "^0.5.1",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "@types/node": "^25.9.2",
    "@types/react": "^18.2.56",
    "@types/react-dom": "^18.2.19",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.5.0",
    "esbuild": "^0.28.1",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.3.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
