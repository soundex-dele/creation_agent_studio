{
  "name": "agent-studio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:api-schema": "python ../backend/manage.py generate_swagger ../contracts/swagger.json --overwrite --format json && swagger2openapi ../contracts/swagger.json -o ../contracts/openapi.json",
    "generate:api-types": "openapi-typescript ../contracts/openapi.json -o src/api/generated.ts",
    "generate:api": "npm run generate:api-schema && npm run generate:api-types"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@phosphor-icons/react": "^2.1.10",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/markdown": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.11.6",
    "antd": "^5.29.3",
    "axios": "^1.18.0",
    "katex": "^0.16.47",
    "lucide-react": "^0.555.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "sass": "^1.100.0",
    "swagger2openapi": "^7.0.8",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "@types/node": "^25.9.2",
    "@types/react": "^18.2.56",
    "@types/react-dom": "^18.2.19",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.5.0",
    "esbuild": "^0.28.1",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.3.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
